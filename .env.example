# Medical AI System Environment Configuration
PROJECT_NAME="Intelligent Medical Image-Based Tumor Detection and Uncertainty Assessment System"
VERSION="1.0.0"
ENVIRONMENT="development"

# Server Settings
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database
DATABASE_URL="sqlite:///./medical_tumor_system.db"

# Model & Decision Support Thresholds
MC_DROPOUT_SAMPLES=15
ABSTENTION_THRESHOLD=0.55
EXPERT_REVIEW_THRESHOLD=0.40
DEFAULT_IMG_SIZE=224

# Directory Paths (Relative to Project Root)
UPLOADS_DIR="uploads"
REPORTS_DIR="reports"
KNOWLEDGE_BASE_DIR="knowledge_base"
CHECKPOINTS_DIR="ml/checkpoints"
DATASETS_DIR="ml/datasets"
